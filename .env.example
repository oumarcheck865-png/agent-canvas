# ============================================================
# Agent Canvas — Configuration d'environnement
# ============================================================
# Ce fichier est un exemple. Copiez-le en .env.local et renseignez les
# valeurs selon votre déploiement. Aucune clé secrète ne doit être committée.
#
# Agent Canvas est une plateforme INDÉPENDANTE du cloud OpenHands/OpenAI.
# Aucune télémétrie n'est envoyée par défaut.
# Le fournisseur IA, les clés API et le runtime agent sont configurés
# manuellement par le propriétaire du projet.
# ============================================================

# ---- Runtime agent (agent-server OpenHands) ----
# URL de l'agent-server auquel la plateforme se connecte.
# Par défaut : runtime local. Laisser vide pour forcer la configuration manuelle
# via l'interface.
# NEXT_PUBLIC_AGENT_SERVER_BASE_URL="http://127.0.0.1:8000"

# Clé de session API agent-server (si l'authentification est activée).
# NE JAMAIS committer une vraie clé. À renseigner dans .env.local uniquement.
# NEXT_PUBLIC_AGENT_SERVER_SESSION_API_KEY=""

# Répertoire de travail de base pour les conversations.
# NEXT_PUBLIC_AGENT_WORKING_DIR="/workspace/project/agent-canvas"

# ---- AI Provider Layer (fournisseur IA indépendant) ----
# Permet au propriétaire de configurer son propre modèle IA, ses clés API,
# son fournisseur LLM ou son cloud. Aucune valeur par défaut n'est codée.
# NEXT_PUBLIC_AI_PROVIDER_KIND="custom"   # openai | anthropic | custom | self-hosted
# NEXT_PUBLIC_AI_PROVIDER_BASE_URL=""
# NEXT_PUBLIC_AI_PROVIDER_MODEL=""
# La clé API du fournisseur IA doit rester côté serveur ou être saisie dans
# l'interface. NE PAS coder de clé ici.
# NEXT_PUBLIC_AI_PROVIDER_API_KEY=""

# ---- Télémétrie ----
# Désactivée par défaut pour garantir l'indépendance du cloud OpenHands.
# Aucune donnée n'est envoyée à PostHog ou à un service tiers.
NEXT_PUBLIC_TELEMETRY_DISABLED="true"

# ---- Authentification ----
# Activer/désactiver l'authentification requise pour accéder à la plateforme.
# NEXT_PUBLIC_AUTH_REQUIRED="false"

# ---- Application ----
# Nom de l'application affiché dans l'interface.
NEXT_PUBLIC_APP_NAME="Agent Canvas"
